# ─────────────────────────────────────────────────────────────────────
# แม่แบบตัวแปรสภาพแวดล้อม — ไฟล์นี้ commit ได้ (ไม่มีค่าจริง)
# คัดลอกเป็น .env.local แล้วกรอกค่า หรือใช้เป็นเช็คลิสต์ตอนตั้งค่า Vercel
#
# กติกา: คำอธิบายอยู่ "บรรทัดบนค่า" เสมอ ห้ามต่อท้ายบรรทัดเดียวกับค่า
# เพราะ dotenv ตัดคอมเมนต์ให้ แต่ `source .env.local` ในเชลล์และสคริปต์อื่นไม่ตัด
# แล้วค่าจะกลายเป็น "คีย์ + ช่องว่าง + คอมเมนต์" ได้ error ว่าคีย์ผิดทั้งที่คีย์ถูก
# ─────────────────────────────────────────────────────────────────────

# ══ Supabase Cloud (ap-southeast-1 / สิงคโปร์) ═══════════════════════
# Dashboard → Settings → API Keys → แท็บ "Publishable and secret API keys"
# ใช้คีย์ชุดใหม่ ไม่ใช่ legacy anon/service_role (legacy หมดอายุสิ้นปี 2026)

NEXT_PUBLIC_SUPABASE_URL=

# sb_publishable_... — ส่งไปกับ JavaScript ในเบราว์เซอร์ตามการออกแบบ ไม่ใช่ความลับ
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# sb_secret_... — ข้ามผ่าน RLS ทั้งหมด ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น
# ห้ามเปลี่ยนชื่อให้ขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด (จะถูกฝังลงบันเดิลที่ส่งให้ทุกคน)
SUPABASE_SECRET_KEY=

# สำหรับ Supabase MCP เท่านั้น — ไม่ต้องใส่ใน Vercel
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ══ Cloudflare R2 (bucket ส่วนตัว เก็บรูปสลิป · Storage class = Standard) ══
# Cloudflare Dashboard → R2 → Manage API Tokens → สิทธิ์ Object Read & Write

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# เว้นว่างได้ — ประกอบจาก R2_ACCOUNT_ID อัตโนมัติ ใส่เฉพาะเวลาจะ override
R2_ENDPOINT=

# ══ ความลับที่สร้างเอง ═══════════════════════════════════════════════
# ตอน deploy ต้องคัดลอก "ชุดเดียวกัน" จาก .env.local ไปใส่ใน Vercel
# ห้ามสร้างใหม่: เปลี่ยน PIN_PEPPER = PIN เดิมใช้ไม่ได้ทุกคน
#                เปลี่ยน VAPID     = push subscription ทุกเครื่องตาย

PIN_PEPPER=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:

# ══ บัญชีสำหรับ seed และทดสอบ ════════════════════════════════════════
# บัญชีทดสอบเท่านั้น — ห้ามใส่ใน Vercel production
# seed อ่านจากตรงนี้ ไม่ฝังลงไฟล์ SQL (ฝังแล้วรหัสติดอยู่ในประวัติ git ตลอดไป)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# PIN ต้องไม่ซ้ำกันระหว่างผู้ใช้ เพราะหน้าล็อกอินระบุตัวตนจาก PIN อย่างเดียว
SEED_SUPERVISOR1_NAME=
SEED_SUPERVISOR1_PIN=
SEED_SUPERVISOR2_NAME=
SEED_SUPERVISOR2_PIN=

# ══ สวิตช์ ═══════════════════════════════════════════════════════════
# ตั้ง = 1 เท่านั้นถึงจะเปิด (opt-in) · ไม่ตั้ง = route ตอบ 404 และปุ่มไม่เรนเดอร์ที่หน้าล็อกอิน — ห้ามเปิดบน production
ENABLE_DEMO_LOGIN=0
